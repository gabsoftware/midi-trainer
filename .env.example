# Copier vers .env.local (ignoré par git) et compléter ; tout est facultatif.
# Lu par Vite en développement et au build : ni domaine ni marque dans le code.

# Adresse publique du site : adresse canonique, aperçu de partage, robots.txt et sitemap.xml.
# Sans elle, ces éléments ne sont pas générés.
VITE_SITE_URL=https://app.example.com/

# Éditeur, affiché dans le pied de page et la page « À propos ».
# Sans VITE_AUTHOR_NAME, aucune mention « Réalisé par ».
VITE_AUTHOR_NAME=Votre nom
VITE_AUTHOR_URL=https://example.com
# Lien vers le code source (la licence GPL demande de le proposer aux utilisateurs).
VITE_SOURCE_URL=https://example.com/code/midi-trainer
